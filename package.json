{
  "name": "dsh-chat-projects",
  "version": "0.1.0",
  "description": "ChatGPT Projects style chat organizer for DeepSeek Harness: move sessions between workspaces (projects) and file ungrouped chats back into their project.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/core.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "projects",
    "workspace",
    "chatgpt-projects"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "Tzh0109",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tzh0109/DSH-projects.git"
  },
  "homepage": "https://github.com/Tzh0109/DSH-projects#readme",
  "bugs": {
    "url": "https://github.com/Tzh0109/DSH-projects/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}